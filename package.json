{
  "scripts": {
    "build": "node build.js",
    "postbuild": "node scripts/health/report-build.mjs",
    "deploy": "node build.js && npx wrangler pages deploy dist --project-name retro-rave-radio --branch main --commit-dirty=true",
    "health": "node scripts/health/run.js",
    "smoke": "node scripts/smoke-generated-seeds.js && node scripts/smoke-games.js",
    "validate:games": "node scripts/audit-music-driven.js",
    "validate:pack": "node scripts/validate-game-pack.js",
    "validate:pack:strict": "node scripts/validate-game-pack.js --strict",
    "audition:music": "node build.js && node scripts/audition-generated-music.js --seeds 60",
    "audition:render": "node build.js && node scripts/audition-generated-music.js --render",
    "scaffold:game": "node scripts/scaffold-game-pack.js",
    "pack:tools": "node scripts/pack-tools.js"
  },
  "devDependencies": {
    "@stack/health-kit": "file:../stack/health-kit",
    "playwright": "^1.61.1"
  }
}
