  },
  "dependencies": {
    "@remotion/cli": "4.0.374",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.374"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
