{
  "name": "chiptunes-promo-video",
  "private": true,
  "scripts": {
    "capture": "node capture.mjs",
    "render": "remotion render src/index.ts ChiptunesPromo out/chiptunes-promo.mp4 --codec=h264 --crf=18",
