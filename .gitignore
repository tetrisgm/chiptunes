# Local-only: 3.9 GB of uncompressed source rips. Re-downloadable from the Internet Archive.
# Convert into distributable music packs with `node scripts/pack-tools.js music build|convert-chip`.
# NEVER commit these.
chip-originals/

# Local-only processed music corpus (analysis outputs, reference tracks for the audition A/B loop).
chip-derived/

# Legacy served chip library (copyrighted). Superseded by user-installed music packs under
# dist/packs/music/. Untracked so the app ships ZERO copyrighted content; local files may remain.
dist/chip/

# Build output — regenerated by `node build.js` (source of truth is src/ + packs/)
dist/index.html
dist/radio/
dist/browse/
dist/watch/
dist/docs/

# Published packs — first-party game/composer packs are rebuilt by build.js;
# dist/packs/music/ is the user's own converted library (never in git)
dist/packs/

# OS / logs / deps
.DS_Store
*.log
node_modules/

# Secrets belt-and-braces (credentials must never land in git)
.igdb-creds.json
__pycache__/
.claude/
chip-originals
chip-derived

# health-kit self-report output (local-authoritative; uploaded separately).
# Root-anchored so it ignores ONLY the top-level output dir, NOT scripts/health/ source.
/health/
