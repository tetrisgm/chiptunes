{
  "name": "chiptunes-app-desktop",
  "version": "0.1.69",
  "description": "Chiptunes.app for desktop and macOS animated wallpaper mode.",
  "author": "Chiptunes.app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "wallpaper": "electron . --wallpaper",
    "build:native": "node scripts/build-native.js",
    "build:native:arm64": "node scripts/build-native.js arm64",
    "test:native": "node scripts/native-smoke.js",
    "test:desktop": "node scripts/desktop-smoke.js",
    "check": "node --check main.js && node --check preload.js && node --check wallpaper.js && node --check power.js && node --check settings.js && node --check tray.js && node --check audio-diagnostics.js && node --check window-lifecycle.js && node --check user-data.js && node --check scripts/build-native.js && node --check scripts/native-smoke.js && node --check scripts/desktop-smoke.js",
    "pack:mac": "npm run build:native:arm64 && electron-builder --mac dir --arm64",
    "dist:mac": "npm run build:native:arm64 && electron-builder --mac dmg zip --arm64",
    "dist:linux": "electron-builder --linux AppImage --x64 -c.npmRebuild=false",
    "dist:win": "electron-builder --win portable nsis --x64 -c.npmRebuild=false",
    "release:mac": "scripts/release-mac.sh",
    "install": "npm run build:native"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-addon-api": "^8.5.0",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "^26.0.12",
    "node-gyp": "^11.4.2"
  },
  "build": {
    "appId": "net.ramine.retroraveradio",
    "productName": "Chiptunes",
    "asar": true,
    "asarUnpack": [
      "build/Release/*.node",
      "node_modules/steamworks.js/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "wallpaper.js",
      "power.js",
      "settings.js",
      "tray.js",
      "audio-diagnostics.js",
      "window-lifecycle.js",
      "user-data.js",
      "steam_appid.txt",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Chiptunes.app analyzes system audio levels and tempo to animate your wallpaper. Audio is never recorded or transmitted."
      },
      "files": [
        "build/Release/*.node"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Chiptunes-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Chiptunes-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Chiptunes-${version}-${arch}.${ext}"
    },
    "artifactName": "Chiptunes-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.chiptunes.app"
      }
    ]
  }
}
